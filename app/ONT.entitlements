<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Nécessite que l'App ID porte la même capacité sur
	     le portail développeur, et un DEVELOPMENT_TEAM renseigné. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Liens universels. iOS va chercher
	     https://ontbible.com/.well-known/apple-app-site-association à
	     l'installation et à chaque mise à jour, et n'ouvre l'app que si ce
	     fichier nomme cet App ID. Il est servi par la Lambda.

	     Le domaine nomme le projet, le bundle porte le nom français : les
	     deux ne coïncident pas, et c'est voulu. Un identifiant d'app est gelé
	     à la première publication. -->
	<!-- Les notifications distantes. `development` en debug, `production` en
	     livraison : Xcode substitue la valeur selon le profil. Une valeur
	     figée ferait refuser tous les jetons par le serveur APNs de l'autre
	     environnement, avec une erreur qui ne nomme pas la cause.

	     Nécessite que l'App ID porte la capacité Push Notifications sur le
	     portail développeur, et une clé APNs (.p8) côté backend. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ontbible.com</string>
	</array>
</dict>
</plist>
