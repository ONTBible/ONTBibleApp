<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Le corpus se télécharge, et le compte se synchronise. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Depuis Android 13, notifier demande une permission à l'exécution. Elle
      est unique pour l'app — mais les deux usages, verset du jour et parutions,
      seront deux *canaux* distincts. Le lecteur coupe donc l'un sans l'autre
      depuis les réglages système, ce qu'iOS ne sait pas faire.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Le retour prédictif — l'aperçu de l'écran d'arrivée pendant qu'on tire
      depuis le bord.

      En `targetSdk 36` sur Android 16+, il est déjà actif sans ce drapeau : ce
      qu'on gagne ici, ce sont Android 13, 14 et 15, c'est-à-dire la majorité
      du parc. Le drapeau ne gouverne **que** l'animation — `OnBackPressedCallback`
      est appelé quoi qu'il arrive, donc aucune logique de retour ne change.

      Ce qui reste à faire et qui n'est pas ici : le `BackHandler` de
      `MainActivity` est actif sur tout sous-écran, et un callback de priorité
      normale empêche le système de jouer ses animations — il ne peut pas
      animer une transition dont il ignore l'issue. Tant qu'il n'est pas rendu
      plus étroit, ce drapeau ne se voit que là où l'app n'intercepte pas.
    -->
    <application
        android:name=".ONTApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ONT">

        <!--
          `singleTask` : sans lui, une notification touchée alors que l'app est
          déjà ouverte empilerait une seconde activité au lieu de rendre la
          main à celle qui existe. `onNewIntent` ne serait jamais appelé, et le
          lien ne marcherait qu'à froid.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ONT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Le lien **public**, celui qui circule réellement.

              Un `ont://` collé dans une conversation n'est pas cliquable et ne
              mène nulle part pour qui n'a pas l'app. Ce qu'on partage est une
              adresse web, que le site sait servir de son côté — donc le lecteur
              sans l'app lit quand même, et celui qui l'a est amené dedans.

              `autoVerify` demande à Android de vérifier
              `https://ontbible.com/.well-known/assetlinks.json` à
              l'installation. Tant que ce fichier n'est pas servi, le lien
              ouvrira le sélecteur d'app au lieu d'aller droit à l'ONT — pas de
              régression, seulement une étape de moins qu'espéré.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ontbible.com" />
                <data android:scheme="https" android:host="www.ontbible.com" />
            </intent-filter>

            <!--
              Le schéma interne — widget, notification, fiche de lexique. Il ne
              sort pas de l'appareil et n'a donc rien à vérifier.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ont" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.VersetDuJourWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_verset_du_jour" />
        </receiver>
    </application>
</manifest>
